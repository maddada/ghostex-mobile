{
  // The Find page is a browser page, not React Native code, and it imports shared UI from the
  // Ghostex main repo this app is checked out inside (apps/mobile/app). `@/` is that repo's root,
  // and every package resolves from its node_modules so the page gets the same React and types as
  // the shared UI (this app's own node_modules pin React Native's React). esbuild reads the same
  // paths when scripts/build-find-page.mjs bundles the page.
  "extends": "../../../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../../../../../*"],
      "*": ["../../../../../node_modules/@types/*", "../../../../../node_modules/*"]
    },
    "typeRoots": ["../../../../../node_modules/@types"]
  },
  "include": [
    "./**/*",
    "../../../../../packages/shared/asset-modules.d.ts",
    "../../../../../packages/shared/typecheck-shims.d.ts"
  ],
  "exclude": ["./**/*.test.ts"]
}
