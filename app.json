{
  "expo": {
    "name": "Ghostex",
    "slug": "ghostex-mobile",
    "version": "10.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#181818",
    "scheme": ["ghostex", "ghostex-ec1", "ghostex-ts1"],
    "plugins": [
      "./plugins/withAndroidReleaseSigning.js",
      "./plugins/withAndroidReleaseSize.js",
      "./plugins/withLoopbackCleartext.js",
      "./plugins/withVoiceLiveActivity.js",
      "./plugins/withWidgets.js",
      "./plugins/withGhostexNativeTests.js",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Ghostex uses the camera to scan the pairing QR code shown on your computer, and when you capture a photo to attach to a session.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ghostex uses the microphone when you talk with the voice agent, dictate a message in the chat or record a video to attach to a session.",
          "speechRecognitionPermission": "Ghostex turns what you dictate in the chat into text."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withoutBackgroundFetch.js"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maddada.ghostex.ios",
      "appleTeamId": "KTKP595G3B",
      "associatedDomains": ["applinks:ghostex.dev"],
      "entitlements": {
        "application-identifier": "$(AppIdentifierPrefix)com.maddada.ghostex.ios",
        "keychain-access-groups": ["$(AppIdentifierPrefix)com.maddada.ghostex.ios"],
        "com.apple.security.application-groups": ["group.com.maddada.ghostex.ios"]
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ghostex connects straight to your computer when it is on the same network, which is faster than going through the internet.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": ["tailscale"],
        "UIAppFonts": ["JetBrainsMonoNerdFont-Regular.ttf"],
        "NSPhotoLibraryUsageDescription": "Ghostex uses your photo library so you can attach images to your sessions.",
        "NSCameraUsageDescription": "Ghostex uses the camera to scan the pairing QR code shown on your computer, and when you capture a photo to attach to a session.",
        "NSMicrophoneUsageDescription": "Ghostex uses the microphone when you talk with the voice agent, dictate a message in the chat or record a video to attach to a session.",
        "NSSpeechRecognitionUsageDescription": "Ghostex turns what you dictate in the chat into text.",
        "UIBackgroundModes": ["audio", "voip"],
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          }
        ]
      }
    },
    "android": {
      "package": "io.ghostex",
      "adaptiveIcon": {
        "backgroundColor": "#ECE8DE",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "ghostex.dev", "path": "/pair" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "maddada",
    "extra": {
      "eas": {
        "projectId": "12ee8101-5ce6-4931-8a32-1ecc52de0b5e"
      }
    }
  }
}
