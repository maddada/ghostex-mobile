<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed persistent-notification content (ported from the Termux fork's
  notification_ghostex_collapsed): summary line + two tappable session rows,
  each a small colored dot + single-line title.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <TextView
      android:id="@+id/ghostex_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:singleLine="true"
      android:ellipsize="end"
      android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

  <LinearLayout
      android:id="@+id/ghostex_row1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingTop="2dp">
    <TextView
        android:id="@+id/ghostex_row1_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="6dp"
        android:textSize="9sp" />
    <TextView
        android:id="@+id/ghostex_row1_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/ghostex_row2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingTop="2dp">
    <TextView
        android:id="@+id/ghostex_row2_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="6dp"
        android:textSize="9sp" />
    <TextView
        android:id="@+id/ghostex_row2_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
  </LinearLayout>

</LinearLayout>
